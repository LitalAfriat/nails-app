{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true, 
    "noImplicitAny": true, 
     "noImplicitReturns": true,  
    "strictNullChecks": true
  }
}